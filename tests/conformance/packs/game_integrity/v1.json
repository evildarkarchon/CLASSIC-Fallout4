    }
  ],
  "scenarios": [
    {
      "id": "valid",
      "action": "game-integrity.basic",
      "capabilityIds": [
        "game-integrity.basic"
      ],
      "fixtureRefs": [
        "valid"
      ],
      "input": {
        "fixtureRef": "valid"
