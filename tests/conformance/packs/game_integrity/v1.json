      "expected": {
        "checks": [
          {
            "isValid": true,
            "message": "\u2714\ufe0f You have the latest version of Fallout 4! \n-----\n",
            "checkType": "ExecutableVersion"
          },
          {
            "isValid": true,
            "message": "\u2714\ufe0f Your Fallout 4 game files are installed outside of the Program Files folder! \n-----\n",
            "checkType": "InstallationLocation"
          }
        ],
        "report": "\u2714\ufe0f You have the latest version of Fallout 4! \n-----\n\u2714\ufe0f Your Fallout 4 game files are installed outside of the Program Files folder! \n-----\n",
        "files": [
          {
            "path": "game/Fallout4.exe",
            "content": "known executable fixture\n"
          }
        ]
      },
