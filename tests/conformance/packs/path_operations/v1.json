      "id": "required-files-present",
      "action": "path-operations.validate",
      "capabilityIds": [
        "path-operations.validate"
      ],
      "fixtureRefs": [
        "required-files-present"
      ],
      "input": {
        "fixtureRef": "required-files-present"
      },
      "expected": {
        "path": "game",
        "exists": true,
        "requiredFiles": {
          "accepted": true,
          "error": null
        }
      },
      "normalization": {
        "rootRelativePaths": false,
        "unorderedPaths": [],
        "excludedPaths": []
      }
    },
    {
      "id": "required-file-missing",
      "action": "path-operations.validate",
      "capabilityIds": [
        "path-operations.validate"
      ],
      "fixtureRefs": [
        "required-file-missing"
      ],
      "input": {
        "fixtureRef": "required-file-missing"
      },
      "expected": {
        "path": "game",
        "exists": true,
        "requiredFiles": {
          "accepted": false,
          "error": "Required file 'Missing.exe' not found in path: game"
        }
      },
      "normalization": {
        "rootRelativePaths": false,
        "unorderedPaths": [],
        "excludedPaths": []
      }
    },
    {
      "id": "missing-directory",
      "action": "path-operations.validate",
      "capabilityIds": [
        "path-operations.validate"
      ],
      "fixtureRefs": [
        "missing-directory"
      ],
      "input": {
        "fixtureRef": "missing-directory"
      },
      "expected": {
        "path": "absent",
        "exists": false,
        "requiredFiles": {
          "accepted": false,
          "error": "Path does not exist: absent"
        }
      },
      "normalization": {
        "rootRelativePaths": false,
        "unorderedPaths": [],
        "excludedPaths": []
      }
    },
    {
      "id": "file-as-directory",
      "action": "path-operations.validate",
      "capabilityIds": [
        "path-operations.validate"
      ],
      "fixtureRefs": [
        "file-as-directory"
      ],
      "input": {
        "fixtureRef": "file-as-directory"
      },
      "expected": {
        "path": "game/Fallout4.exe",
        "exists": true,
        "requiredFiles": {
          "accepted": false,
          "error": "Path is not a directory: game/Fallout4.exe"
        }
      },
      "normalization": {
        "rootRelativePaths": false,
        "unorderedPaths": [],
        "excludedPaths": []
      }
