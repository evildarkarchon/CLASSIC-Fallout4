      "fixtureRefs": [
        "empty-required-list"
      ],
      "input": {
        "fixtureRef": "empty-required-list"
      },
      "expected": {
        "path": "game",
        "exists": true,
        "requiredFiles": {
          "accepted": true,
          "error": null
        }
      },
      "normalization": {
        "rootRelativePaths": false,
        "unorderedPaths": [],
