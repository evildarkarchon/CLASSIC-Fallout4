        "htmlBody": "<h2>Encoded</h2>\n<p>A &lt; B &amp; C.</p>\n<p><code>x &lt; y</code></p>\n",
        "documentComplete": true
      },
      "normalization": {
        "rootRelativePaths": false,
        "excludedPaths": [],
        "unorderedPaths": []
      }
    },
