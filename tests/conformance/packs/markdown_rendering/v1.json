      "expected": {
        "normalized": "**Alert**\n\n-----\n\n## Details\n\n- alpha\n- beta",
        "htmlBody": "<p><strong>Alert</strong></p>\n<hr />\n<h2>Details</h2>\n<ul>\n<li>alpha</li>\n<li>beta</li>\n</ul>\n",
        "documentComplete": true
      },
      "normalization": {
        "rootRelativePaths": false,
        "excludedPaths": [],
        "unorderedPaths": []
      }
    },
    {
      "id": "escaping",
      "action": "markdown-rendering.observe",
      "capabilityIds": [
        "markdown-rendering.observe"
      ],
      "fixtureRefs": [
        "escaping"
      ],
      "input": {
        "fixtureRef": "escaping"
      },
      "expected": {
