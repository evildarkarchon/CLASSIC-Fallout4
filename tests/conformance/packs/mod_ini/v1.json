      },
      "expected": {
        "operation": "cache",
        "before": [
          {
            "path": "A/dup.ini",
            "content": "[Settings]\nvalue=same\n"
          },
          {
            "path": "B/dup.ini",
            "content": "[Settings]\nvalue=same\n"
          },
          {
            "path": "sample.ini",
            "content": "[Settings]\nname=hello\nenabled=yes\ncount=7\nscale=2.5\n"
          }
        ],
        "result": {
          "names": [
            "dup.ini",
            "sample.ini"
          ],
          "contains": true,
          "path": "sample.ini",
          "name": "hello",
          "enabled": true,
          "count": 7,
          "scale": "2.500",
          "hasName": true,
          "missing": null,
          "duplicates": {
            "dup.ini": [
              "A/dup.ini",
              "B/dup.ini"
            ]
          }
        },
        "files": [
          {
            "path": "A/dup.ini",
            "content": "[Settings]\nvalue=same\n"
          },
          {
            "path": "B/dup.ini",
            "content": "[Settings]\nvalue=same\n"
          },
          {
            "path": "sample.ini",
            "content": "[Settings]\nname=hello\nenabled=yes\ncount=7\nscale=2.5\n"
          }
        ]
