{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evildarkarchon/CLASSIC-Fallout4/tests/conformance/schemas/scenario-pack-v1.schema.json",
  "title": "CLASSIC conformance scenario pack v1",
  "x-classic-reject-floating-point-lexemes": true,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "familyVersion",
    "domainOwner",
    "fixtureRoot",
    "fixtures",
    "capabilities",
    "scenarios",
    "consumerObligations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "familyId": { "$ref": "#/$defs/stableId" },
    "familyVersion": { "type": "integer", "minimum": 1 },
    "domainOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustCrate"],
      "properties": {
        "rustCrate": { "$ref": "#/$defs/stableId" }
      }
    },
    "fixtureRoot": { "$ref": "#/$defs/relativePath" },
    "fixtures": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/fixtureRef" },
      "additionalProperties": { "$ref": "#/$defs/relativePath" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rustSymbols", "observationFamilies"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "rustSymbols": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "observationFamilies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stableId" }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "capabilityIds",
          "fixtureRefs",
          "input",
          "expected",
          "normalization"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "action": { "$ref": "#/$defs/stableId" },
          "capabilityIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/stableId" }
          },
          "fixtureRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/fixtureRef" }
          },
          "input": { "$ref": "#/$defs/canonicalJsonObject" },
          "expected": { "$ref": "#/$defs/canonicalJsonObject" },
          "normalization": { "$ref": "#/$defs/normalization" }
        }
      }
    },
    "consumerObligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "fixtureRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "canonicalJsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/canonicalJsonValue" }
    },
    "canonicalJsonValue": {
      "description": "Canonical JSON value. The loader additionally rejects integer-valued float lexemes such as 1.0, which JSON Schema cannot distinguish after parsing.",
      "x-classic-number-lexeme": "integer-only",
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalJsonValue" }
        },
        { "$ref": "#/$defs/canonicalJsonObject", "type": "object" }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "exactJsonPath": {
      "type": "string",
      "pattern": "^\\$(?:(?:\\.[A-Za-z_][A-Za-z0-9_-]*)|(?:\\[(?:0|[1-9][0-9]*)\\]))+$"
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootRelativePaths", "unorderedPaths", "excludedPaths"],
      "properties": {
        "rootRelativePaths": { "type": "boolean" },
        "unorderedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/exactJsonPath" }
        },
        "optionalEmptyFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "relativePath", "rationale"],
            "properties": {
              "path": { "$ref": "#/$defs/exactJsonPath" },
              "relativePath": {
                "type": "string",
                "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000]+)*$"
              },
              "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          }
        },
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "rationale"],
            "properties": {
              "path": { "$ref": "#/$defs/exactJsonPath" },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
