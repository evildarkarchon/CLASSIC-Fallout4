{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evildarkarchon/CLASSIC-Fallout4/tests/conformance/schemas/policy-exceptions-v1.schema.json",
  "title": "CLASSIC conformance policy exceptions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exceptions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capabilityId",
          "participantId",
          "rationale",
          "policyPage"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "capabilityId": { "$ref": "#/$defs/stableId" },
          "participantId": { "$ref": "#/$defs/stableId" },
          "rationale": { "type": "string", "minLength": 1 },
          "policyPage": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
