{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classic-fallout4.local/schemas/conformance-report-v1.schema.json",
  "title": "CLASSIC scoped shadow conformance report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "enforcement",
    "scope",
    "result",
    "repositoryComplete",
    "requiredExecutions",
    "receivedExecutions",
    "missingExecutions",
    "failures",
    "coverage",
    "consumerCoverage"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "familyId": { "$ref": "#/$defs/stableId" },
    "enforcement": { "const": "shadow" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "participantId", "executionInstanceId"],
      "properties": {
        "kind": {
          "enum": ["execution-instance", "participant", "full-repository"]
        },
        "participantId": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        },
        "executionInstanceId": {
          "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "execution-instance" },
            "participantId": { "$ref": "#/$defs/stableId" },
            "executionInstanceId": { "$ref": "#/$defs/stableId" }
          }
        },
        {
          "properties": {
            "kind": { "const": "participant" },
            "participantId": { "$ref": "#/$defs/stableId" },
            "executionInstanceId": { "type": "null" }
          }
        },
        {
          "properties": {
            "kind": { "const": "full-repository" },
            "participantId": { "type": "null" },
            "executionInstanceId": { "type": "null" }
          }
        }
      ]
    },
    "result": { "enum": ["pass", "fail"] },
    "repositoryComplete": { "type": "boolean" },
    "requiredExecutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/execution" }
    },
    "receivedExecutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/execution" }
    },
    "missingExecutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/execution" }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "participantId",
          "executionInstanceId",
          "message"
        ],
        "properties": {
          "kind": {
            "enum": [
              "local_environment_failure",
              "adapter_command_failure",
              "missing_execution_receipt",
              "malformed_execution_receipt",
              "stale_execution_receipt",
              "applicability_violation",
              "coverage_mapping_gap",
              "normalization_failure",
              "semantic_conformance_mismatch",
              "structural_contract_drift",
              "negative_contract_violation"
            ]
          },
          "participantId": {
            "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
          },
          "executionInstanceId": {
            "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }]
          },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "familyId",
            "result",
            "executionEvidence",
            "preparedEvidenceDigest",
            "rows",
            "failures"
          ],
          "properties": {
            "familyId": { "$ref": "#/$defs/stableId" },
            "result": { "enum": ["pass", "fail"] },
            "executionEvidence": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/execution" }
            },
            "preparedEvidenceDigest": { "$ref": "#/$defs/sha256" },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "obligationId",
                  "participantId",
                  "mappingOrigin",
                  "capabilityId",
                  "evidenceKind",
                  "evidenceIds"
                ],
                "properties": {
                  "obligationId": { "type": "string", "minLength": 1 },
                  "participantId": { "$ref": "#/$defs/stableId" },
                  "mappingOrigin": {
                    "enum": ["canonical_rust", "binding_only", "rust_only"]
                  },
                  "capabilityId": {
                    "oneOf": [
                      { "$ref": "#/$defs/stableId" },
                      { "type": "null" }
                    ]
                  },
                  "evidenceKind": {
                    "enum": [
                      "executable",
                      "structural",
                      "negative",
                      "policy-exception"
                    ]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/stableId" }
                  }
                }
              }
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "obligationId", "blocking", "message"],
                "properties": {
                  "kind": { "const": "coverage_mapping_gap" },
                  "obligationId": { "type": "string", "minLength": 1 },
                  "blocking": { "type": "boolean" },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "consumerCoverage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "familyId",
            "result",
            "executionEvidence",
            "preparedEvidenceDigest",
            "obligations",
            "failures"
          ],
          "properties": {
            "familyId": { "$ref": "#/$defs/stableId" },
            "result": { "enum": ["pass", "fail"] },
            "executionEvidence": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/execution" }
            },
            "preparedEvidenceDigest": { "$ref": "#/$defs/sha256" },
            "obligations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["obligationId", "participantId", "evidenceIds"],
                "properties": {
                  "obligationId": { "$ref": "#/$defs/stableId" },
                  "participantId": { "$ref": "#/$defs/stableId" },
                  "evidenceIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/stableId" }
                  }
                }
              }
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "obligationId", "blocking", "message"],
                "properties": {
                  "kind": { "const": "coverage_mapping_gap" },
                  "obligationId": { "$ref": "#/$defs/stableId" },
                  "blocking": { "type": "boolean" },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": { "type": "null" },
          "consumerCoverage": { "type": "null" }
        },
        "required": ["coverage", "consumerCoverage"]
      },
      "then": {
        "properties": {
          "result": { "const": "fail" },
          "repositoryComplete": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "repositoryComplete": { "const": true } } },
      "then": {
        "properties": {
          "scope": {
            "properties": { "kind": { "const": "full-repository" } }
          },
          "result": { "const": "pass" }
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "executionInstanceId"],
      "properties": {
        "participantId": { "$ref": "#/$defs/stableId" },
        "executionInstanceId": { "$ref": "#/$defs/stableId" }
      }
    }
  }
}
